ARG BASE_IMAGE=ghcr.io/inria-paris-robotics-lab/prl_docker-base:jazzy-latest
FROM ${BASE_IMAGE}

ARG ROS_DISTRO=jazzy
ARG USERNAME=ros
ENV DEBIAN_FRONTEND=noninteractive

USER root

# Install ROS2 dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
  python3-argcomplete \
  ros-dev-tools \
  ros-${ROS_DISTRO}-ros2-control \
  ros-${ROS_DISTRO}-ros2-controllers \
  ros-${ROS_DISTRO}-ur \
  ros-${ROS_DISTRO}-librealsense2* \
  ros-${ROS_DISTRO}-realsense2-* \
  ros-${ROS_DISTRO}-moveit \
  ros-${ROS_DISTRO}-tf-transformations \
  ros-${ROS_DISTRO}-image-pipeline \
  ros-${ROS_DISTRO}-plotjuggler-ros \
  adb \
  && rm -rf /var/lib/apt/lists/*

RUN apt-get update && \
    if apt-cache show ros-${ROS_DISTRO}-moveit-py >/dev/null 2>&1; then \
        apt-get install -y ros-${ROS_DISTRO}-moveit-py --no-install-recommends; \
    else \
        apt-get install -y ros-${ROS_DISTRO}-pymoveit2 --no-install-recommends; \
    fi && \
    rm -rf /var/lib/apt/lists/*

# Orbbec driver dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
  libgflags-dev nlohmann-json3-dev \
  ros-${ROS_DISTRO}-image-transport \
  ros-${ROS_DISTRO}-image-transport-plugins \
  ros-${ROS_DISTRO}-compressed-image-transport \
  ros-${ROS_DISTRO}-image-publisher \
  ros-${ROS_DISTRO}-camera-info-manager \
  ros-${ROS_DISTRO}-diagnostic-updater \
  ros-${ROS_DISTRO}-diagnostic-msgs \
  ros-${ROS_DISTRO}-statistics-msgs \
  ros-${ROS_DISTRO}-backward-ros libdw-dev \
  && rm -rf /var/lib/apt/lists/*

# Camera calibration (prl_camera_calib): python dependencies and MC-Calib build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
  python3-numpy python3-scipy python3-yaml python3-opencv python3-pil \
  ros-${ROS_DISTRO}-ur-msgs ros-${ROS_DISTRO}-xacro \
  build-essential cmake \
  libopencv-dev libopencv-contrib-dev libceres-dev libgoogle-glog-dev libeigen3-dev \
  libboost-log-dev libboost-system-dev libboost-test-dev \
  && rm -rf /var/lib/apt/lists/*

# Python packages go through uv (parallel downloads, fast resolver) into /usr/local, shadowing the
# apt python3-* ones. --compile-bytecode as pip does, so the first torch/lerobot import is not slow.
COPY --from=ghcr.io/astral-sh/uv:0.12.24 /uv /usr/local/bin/uv
ENV UV_SYSTEM_PYTHON=1 UV_BREAK_SYSTEM_PACKAGES=1 UV_NO_CACHE=1 UV_COMPILE_BYTECODE=1

# pyorbbecsdk (camera_rig orbbec_rig): --no-deps, numpy / OpenCV come from requirements.txt below
RUN uv pip install --no-deps pyorbbecsdk2==2.1.2

# torch first, from the CUDA or CPU wheel index: cu128 also runs on a PC without GPU (falls back
# to CPU) but adds ~5 GB; TORCH_VARIANT=cpu for a smaller image. Versions inside lerobot 0.6.1's range.
ARG TORCH_VARIANT=cu128
RUN uv pip install --index-url https://download.pytorch.org/whl/${TORCH_VARIANT} \
      torch==2.10.0 torchvision==0.25.0

# Python deps (lerobot, pinocchio/pink, numpy-2 builds of scipy/opencv/transforms3d): add new ones there
COPY robots/mantis/requirements.txt /tmp/requirements.txt
# lerobot pulls the cmake 4 wheel, which shadows apt cmake 3.28 and rejects old cmake_minimum_required
# (MC-Calib, many ROS packages): remove it, lerobot does not run cmake.
RUN uv pip install -r /tmp/requirements.txt \
  && uv pip uninstall cmake \
  && echo /opt/openrobots/lib > /etc/ld.so.conf.d/openrobots.conf && ldconfig \
  && cmake --version | grep -q "^cmake version 3\." \
  && . /opt/ros/${ROS_DISTRO}/setup.sh \
  && python3 -c "import lerobot, torch, numpy, cv2, pinocchio, pink, qpsolvers, tf_transformations, rclpy; \
print('python deps OK: numpy', numpy.__version__, '| torch', torch.__version__, '| cv2', cv2.__version__)"

# MC-Calib, binary on the PATH as mc_calib_calibrate
ARG MC_CALIB_COMMIT=77cb043
RUN git clone https://github.com/rameau-fr/MC-Calib.git /opt/MC-Calib \
  && git -C /opt/MC-Calib checkout ${MC_CALIB_COMMIT} \
  && cmake -S /opt/MC-Calib -B /opt/MC-Calib/build -DCMAKE_BUILD_TYPE=Release \
  && cmake --build /opt/MC-Calib/build --target calibrate -j"$(nproc)" \
  && ln -s /opt/MC-Calib/build/apps/calibrate/calibrate /usr/local/bin/mc_calib_calibrate


################################
# Dependencies built from source
################################
# On passe temporairement en USER ros pour compiler proprement
# Cela évite d'avoir des fichiers root dans le home
USER ${USERNAME}
WORKDIR /home/${USERNAME}

# Create a directory to store data
RUN mkdir -p share
SHELL ["/bin/bash", "-c"]

# Compilation Orbbec
WORKDIR /home/${USERNAME}/ros2_utils_ws/src
RUN git clone https://github.com/orbbec/OrbbecSDK_ROS2.git -b v2-main
WORKDIR /home/${USERNAME}/ros2_utils_ws
RUN source /opt/ros/${ROS_DISTRO}/setup.bash \
    && colcon build --cmake-args -DCMAKE_BUILD_TYPE=Release

# --- UPDATE .bashrc ---
# hadolint ignore=SC2016
RUN mkdir -p /home/${USERNAME}/share \
    && echo "source ~/ros2_utils_ws/install/setup.bash" >> ~/.bashrc \
    && echo "source ~/share/mantis_ws/install/setup.bash" >> ~/.bashrc \
    `# robotpkg pinocchio (numpy 1.x) on PYTHONPATH / LD_LIBRARY_PATH shadows the pip numpy-2 wheel:` \
    `# drop both, C++ still finds /opt/openrobots/lib through ld.so.conf (set above)` \
    && echo 'export PYTHONPATH=${PYTHONPATH//:\/opt\/openrobots\/lib\/python3.12\/site-packages/}' >> ~/.bashrc \
    && echo 'export LD_LIBRARY_PATH=${LD_LIBRARY_PATH//\/opt\/openrobots\/lib:/}' >> ~/.bashrc \
    && echo "export GZ_SIM_RESOURCE_PATH=\$GZ_SIM_RESOURCE_PATH:/opt/ros/${ROS_DISTRO}/share:/home/${USERNAME}/ros2_utils_ws/install/orbbec_description/share:/home/${USERNAME}/share/mantis_ws/install/robotiq_ft_sensor_description/share" >> ~/.bashrc

# --- FINAL STEP ---
# Update .bashrc and Gazebo paths (Consolidated RUN instructions)

USER root
WORKDIR /home/${USERNAME}

COPY robots/mantis/setup_mantis.sh /.entrypoint-setup/setup_mantis.sh
RUN chmod +x /.entrypoint-setup/setup_mantis.sh
